{
	"name": "racing-manager",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"main": "dist-electron/main.js",
	"scripts": {
		"dev": "vite dev",
		"dev:electron": "pnpm run build:electron && concurrently -k \"BROWSER=none vite dev --host 127.0.0.1 --port 5180 --strictPort\" \"wait-on http://127.0.0.1:5180 && node scripts/run-electron-dev.mjs\"",
		"build": "vite build && pnpm run build:electron",
		"build:electron": "vite build --config electron.vite.config.ts",
		"start": "electron .",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"sim:race": "tsx src/lib/sim/cli/run-race.ts",
		"sim:batch": "tsx src/lib/sim/cli/run-batch.ts",
		"sim:weather-batch": "tsx src/lib/sim/cli/run-weather-batch.ts",
		"test:sim": "vitest run src/lib/sim/tests",
		"db:generate": "drizzle-kit generate",
		"db:check": "node scripts/db-schema-check.mjs",
		"db:content-check": "tsx scripts/db-content-check.ts",
		"db:checkpoint-check": "tsx scripts/db-checkpoint-check.ts",
		"db:result-check": "tsx scripts/db-result-check.ts",
		"db:adapter-check": "tsx scripts/db-adapter-check.ts",
		"db:session-check": "tsx scripts/db-session-check.ts",
		"db:catalog-check": "tsx scripts/db-catalog-check.ts",
		"db:read-model-check": "tsx scripts/db-read-model-check.ts",
		"db:session-factory-check": "tsx scripts/db-session-factory-check.ts",
		"db:input-resolver-check": "tsx scripts/db-session-factory-check.ts",
		"db:session-materializer-check": "tsx scripts/db-session-factory-check.ts",
		"db:reset": "bash scripts/db-reset.sh",
		"db:migrate": "node scripts/db-migrate.mjs",
		"content:nationalities": "tsx scripts/gen-nationalities.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/noto-sans": "^5.3.0",
		"@fontsource/noto-sans-mono": "^5.3.0",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.28.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"concurrently": "^10.0.3",
		"countries-list": "^3.4.1",
		"cross-env": "^10.1.0",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"shadcn-svelte": "^1.4.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.10",
		"wait-on": "^9.0.10"
	},
	"dependencies": {
		"@dicebear/core": "^10.3.2",
		"@dicebear/styles": "^10.2.0",
		"@libsql/client": "^0.15.15",
		"drizzle-orm": "^0.45.2",
		"electron": "^43.0.0",
		"electron-serve": "^3.0.1"
	},
	"packageManager": "pnpm@11.1.0"
}
